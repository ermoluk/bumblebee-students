<?xml version="1.0" encoding="UTF-8"?>
<!--
  bumblebee_sim override of PX4's x500_mono_cam_down.

  Camera mount: pitch -1.5707 (NOT +1.5707) so the optical axis points at the
  ground. With +1.5707 the live camera imaged the sky (camera_link world
  rpy=[0,90,0], optical axis up) and aruco_detect saw zero markers. Flipping
  the pitch sign rotates the optical axis through horizontal to point down at
  the marker grid. Verified by capturing /main_camera/image_raw and confirming
  cv2.aruco detects marker 0 directly below the resting drone.

  z=+0.05 keeps the housing + lens tip inside the shmel mesh; near-clip 0.1m
  means the body geometry never appears in frame.
-->
<sdf version='1.9'>
  <model name='x500_mono_cam_down'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://mono_cam</uri>
      <pose>0 0 0.05 0 -1.5707 0</pose>
      <name>mono_cam</name>
    </include>
    <!-- Joint pose MUST stay at z=0 (matches PX4 default). Putting a non-zero
         z on the joint's relative_to=base_link pose breaks the fixed
         constraint in gz-sim under SDF 1.9 with a merged include — the
         camera_link detaches and falls under gravity to the ground. The
         include pose above is what actually positions the camera. Pitch here
         mirrors the include pose. -->
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0 0 0 0 -1.5707 0</pose>
    </joint>
  </model>
</sdf>
