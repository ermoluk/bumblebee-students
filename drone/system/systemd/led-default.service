[Unit]
Description=Bumblebee default LED pattern (rainbow + rear red + front green)
After=i2c-recover.service
Wants=i2c-recover.service

[Service]
User=lb
ExecStart=/usr/bin/python3 -u /home/lb/ros2_ws/src/bumblebee/scripts/led_default.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
