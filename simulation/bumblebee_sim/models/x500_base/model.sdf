    <!-- Servo arm: the bumblebee's neck + head bulb extracted from shmel.obj
         into servo_arm.obj (models/shmel/meshes/extract_servo.py). Implemented
         as a proper link + revolute joint because gz-sim10's visual_config
         service is material-only — it accepts pose updates and replies
         `data: true` but silently ignores them, so a runtime visual rotation
         needs an actual joint.
         Link pose puts the cylinder's mesh-frame origin at world (0, 0.15,
         0.06) inside base_link's frame — exactly where the cylinder rendered
         as part of base_link_visual before extraction. Roll π/2 lives on the
         visual (not the link) so the joint axis stays plain world Z. Mass is
         vanishingly small so the joint controller doesn't have to fight
         inertia. -->
    <link name="servo_arm_link">
      <pose>0 0.15 0.06 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <visual name="servo_arm_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.6 0.6 0.6</scale>
            <uri>model://shmel/meshes/servo_arm.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
    <!-- Servo rotates about world -X (axis −1 0 0 in link frame, since link is
         not rotated relative to model). With θ=0 the cylinder stands vertical;
         increasing θ tips it forward (towards world +Y, which is the direction
         the cylinder is already offset). Range 0..π/2 = upright to fully
         extended like a proboscis dipping forward, then drone_sim returns to
         centre by sweeping back through 0. -->
    <!-- Fixed for stability: revolute joint + JointPositionController on a
         near-massless link self-oscillates in discrete physics and shakes the
         whole drone. Re-enable as revolute + JointPositionController when sim
         servo control is needed. -->
    <joint name="servo_joint" type="fixed">
      <parent>base_link</parent>
      <child>servo_arm_link</child>
    </joint>
  </model>
</sdf>
