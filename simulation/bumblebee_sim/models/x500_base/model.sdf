      <!-- ╔════ LED strips (bumblebee_sim) ════╗
           Layout matches the real Bumblebee Clover:
             • LED_1, LED_3 = long strips along left/right sides of the body
             • LED_2, LED_6 = front-left, front-right motor lights
             • LED_4, LED_5 = back-left, back-right motor lights
           Motors sit at (±0.174, ±0.174). The motor lights are small discs
           positioned just under each motor base (motor base z=0.032).
           Updated at runtime via gz service /world/.../visual_config from
           drone_sim.set_led(strip, led, r, g, b). Emissive material so the
           colour glows without needing a real light source. -->
      <!-- Side strips: 18cm long tape running ALONG body Y axis (the visual
           long axis after shmel mesh rotation). Mounted on the left/right
           sides of the body box at x=±0.055.
           Thin in X (5mm), long in Y (0.18), tall in Z (2cm). -->
      <visual name="led_1">
        <pose>0.055 0 0.04 0 0 0</pose>
        <geometry><box><size>0.005 0.12 0.01</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
      </visual>
      <visual name="led_3">
        <pose>-0.055 0 0.04 0 0 0</pose>
        <geometry><box><size>0.005 0.12 0.01</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
      </visual>
      <!-- Motor lights: 3cm spheres just below each motor base (motor base at
           z=0.032). Sphere is visible from any camera angle, unlike a flat box
           that disappears when viewed edge-on. -->
      <visual name="led_2">     <!-- front-left motor -->
        <pose>0.13 0.13 0.015 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
      </visual>
      <visual name="led_6">     <!-- front-right motor -->
        <pose>0.13 -0.13 0.015 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
      </visual>
      <visual name="led_4">     <!-- back-left motor -->
        <pose>-0.13 0.13 0.015 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
      </visual>
      <visual name="led_5">     <!-- back-right motor -->
        <pose>-0.13 -0.13 0.015 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
      </visual>
      <!-- Servo arm now lives as its own link (`servo_arm_link`) at the end
           of the model, connected to base_link via the `servo_joint` revolute
           joint and driven by the gz-sim JointPositionController plugin.
           See the bottom of this file. -->

